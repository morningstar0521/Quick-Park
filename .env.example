# Copy to .env on the server:  cp .env.example .env  then edit values

# Public domain for HTTPS. Free option: <your-ip-with-dashes>.sslip.io  e.g. 13-233-45-67.sslip.io
DOMAIN=13-233-45-67.sslip.io

# Generate each with:  openssl rand -hex 32
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Must match the URL people open
CORS_ORIGINS=https://13-233-45-67.sslip.io

# Demo admin login (admin@gmail.com). Keep it simple if you share it on your resume.
ADMIN_PASSWORD=Admin@1234

# Optional: real emails via Gmail (needs a Gmail App Password). Leave blank to skip emails.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
